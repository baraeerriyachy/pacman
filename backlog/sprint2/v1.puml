@startuml
package "fr.ul.acl.start" {
    class Main {
        + {static} main(args : String[]) : void
    }
}

package "fr.ul.acl.engine" {
    class GameEngineGraphical {
    }

    class DrawingPanel {
    }

    class GraphicalInterface {
    }

    interface GamePainter {
    }

    interface GameController {
    }

    interface Game {
    }

    enum Cmd {
    }
}

package "fr.ul.acl.model" {
    class Hero{
        - x : float
        - y : float
        - {static} vitesse : float
        + Hero(x : float, y : float)
        + getX() : float
        + getY() : float
        + getVitesse() : float
        + deplacer(nx : float, ny : float) : void
    }

    class HachimiGame {
        - plateau : Plateau
        - hero : Hero
        - won : boolean
        - startTime : long
        - elapsedSeconds : long
        + HachimiGame(source : String)
        + evolve(commande : Cmd) : void
        + isFinished() : boolean
        + getPlateau() : Plateau
        + getHero() : Hero
        + getElapsedSeconds() : long
    }

    class HachimiPainter {
        - {static} TAILLE_CASE : int
        - game : HachimiGame
        - images : Map<String, Image>
        + HachimiPainter(game : HachimiGame)
        - loadImage(name : String, filename : String) : void
        + draw(im : BufferedImage) : void
        + getWidth() : int
        + getHeight() : int
    }

    class HachimiController {
        - commandeEnCours : Cmd
        - keyboardLayout : KeyboardLayout
        - musicPlayer : MusicPlayer
        + HachimiController()
        + HachimiController(musicPlayer : MusicPlayer)
        + getCommand() : Cmd
        + setKeyboardLayout(layout : KeyboardLayout) : void
        + getKeyboardLayout() : KeyboardLayout
        + setMusicPlayer(musicPlayer : MusicPlayer) : void
        + getMusicPlayer() : MusicPlayer
        + keyPressed(e : KeyEvent) : void
        + keyReleased(e : KeyEvent) : void
        + keyTyped(e : KeyEvent) : void
    }

    class Plateau {
        - largeur : int
        - hauteur : int
        - obstacles : List<Obstacle>
        - sortie : Point
        + Plateau(largeur : int, hauteur : int)
        + estDansLimites(x : int, y : int) : boolean
        + estObstacle(x : int, y : int) : boolean
        + ajouterObstacle(x : int, y : int) : boolean
        + peut_passer(x : float, y : float) : boolean
        + getLargeur() : int
        + getHauteur() : int
        + setSortie(sortie : Point) : void
        + getSortie() : Point
        + arriveSortie(x : int, y : int) : boolean
    }

    class Obstacle {
        - x : int
        - y : int
        + Obstacle(x : int, y : int)
        + getX() : int
        + getY() : int
        + estEnPosition(x : int, y : int) : boolean
    }

    class MapReader {
        - plateau : Plateau
        - depart : Point
        + MapReader(nomFichier : String)
        + getPlateau() : Plateau
        + getDepart() : Point
    }

    class MusicPlayer {
        - clip : Clip
        - muted : boolean
        - volumeControl : FloatControl
        + playBackgroundMusic() : void
        + setMuted(muted : boolean) : void
        + isMuted() : boolean
        + stop() : void
    }

    enum KeyboardLayout {
        AZERTY
        QWERTY
    }

    class OptionsMenu {
        + OptionsMenu(parent : JFrame, controller : HachimiController, musicPlayer : MusicPlayer, onClose : Runnable)
    }

    class WinScreen {
        + WinScreen(elapsedSeconds : long)
    }
}

' Inheritance and implementation
HachimiPainter ..|> GamePainter
HachimiGame ..|> Game
HachimiController ..|> GameController
DrawingPanel --|> JPanel
OptionsMenu --|> JFrame
WinScreen --|> JFrame
GameController --|> KeyListener

' Engine relationships
GameEngineGraphical --> Game : game
GameEngineGraphical --> GamePainter : gamePainter
GameEngineGraphical --> GameController : gameController
GameEngineGraphical --> GraphicalInterface : gui
DrawingPanel --> GamePainter : painter
GraphicalInterface --> DrawingPanel : panel
GameEngineGraphical ..> WinScreen : affiche

' Model relationships
HachimiPainter --> HachimiGame : game
HachimiGame --> Plateau : plateau
HachimiGame --> Hero : hero
HachimiGame --> Cmd : commande
HachimiController --> Cmd : commandeEnCours
HachimiController --> KeyboardLayout : keyboardLayout
HachimiController --> MusicPlayer : musicPlayer
MapReader --> Plateau : plateau
Plateau --> Obstacle : obstacles
OptionsMenu --> HachimiController : controller
OptionsMenu --> MusicPlayer : musicPlayer
Main ..> GameEngineGraphical : lance
@enduml