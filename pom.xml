  <!--dependencyManagement-->

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>1.4.0</version>
        <configuration>
          <mainClass>fr.ul.acl.start.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>